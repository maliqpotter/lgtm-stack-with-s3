{{ else if eq .GroupLabels.alertname "HighHTTP5xxRate" }}{{ template "telegram.message.logerror" . -}}
{{ else }}{{ range .Alerts }}
⚠️ <b>{{ .Labels.alertname }}</b>
<b>Status:</b> {{ .Status }}
<b>Instance:</b> {{ .Labels.instance }}
<b>Summary:</b> {{ .Annotations.summary }}
{{ end }}{{ end -}}
{{ end }}

