{{ define "telegram.message" -}}
{{ if eq .GroupLabels.alertname "EndpointDown" }}{{ template "telegram.message.website" . -}}
{{ else if eq .GroupLabels.alertname "DomainExpiringSoon" }}{{ template "telegram.message.domain" . -}}
{{ else if eq .GroupLabels.alertname "HighMemoryUsage" }}{{ template "telegram.message.ram" . -}}
{{ else if eq .GroupLabels.alertname "HighCPUUsage" }}{{ template "telegram.message.cpu" . -}}
{{ else if eq .GroupLabels.alertname "DiskSpaceLow" }}{{ template "telegram.message.disk" . -}}
