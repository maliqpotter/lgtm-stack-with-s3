// ============================================================
// OTLP Receiver — single entry point for all telemetry
// Apps send traces, metrics, and logs here via OTLP
// gRPC: 4317, HTTP: 4318
// ============================================================

otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces  = [otelcol.exporter.otlp.tempo.input]
    metrics = [otelcol.exporter.prometheus.mimir.input]
    logs    = [otelcol.exporter.loki.default.input]
  }
}

// ============================================================
// Traces → Tempo (OTLP gRPC)
// ============================================================

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}

// ============================================================
// Metrics → Mimir (Prometheus Remote Write)
// ============================================================

otelcol.exporter.prometheus "mimir" {
  forward_to = [prometheus.remote_write.mimir.receiver]
}

prometheus.remote_write "mimir" {
  endpoint {
    url = "http://mimir:9009/api/v1/push"
  }
}

// ============================================================
// Node Metrics Collection
// ============================================================

prometheus.scrape "node_exporter" {
  targets = [
    {"__address__" = "node-exporter:9100"},
  ]
  forward_to = [prometheus.relabel.local_labels.receiver]
  job_name   = "node-exporter"
  scrape_interval = "15s"
}

prometheus.scrape "cadvisor" {
  targets = [
    {"__address__" = "cadvisor:8080"},
  ]
  forward_to = [prometheus.relabel.local_labels.receiver]
  job_name   = "cadvisor"
  scrape_interval = "15s"
}

prometheus.relabel "local_labels" {
  rule {
    target_label = "instance"
    replacement  = coalesce(sys.env("HOSTNAME"), "monitoring-server")
  }
  forward_to = [prometheus.remote_write.mimir.receiver]
}

// ============================================================
// Blackbox Exporter (SSL Expiry, Website & DNS Probing)
// ============================================================

// 1. Probing Website HTTPS & SSL Expiry (Tambahkan URL domain Anda di sini)
prometheus.scrape "blackbox_http" {
  targets = [
    {"__address__" = "https://google.com"},
    // {"__address__" = "https://domain-anda.com"},
    // {"__address__" = "https://subdomain.domain-anda.com"},
  ]
  metrics_path = "/probe"
  params = {
    "module" = ["http_2xx"],
  }
  relabel_rules = prometheus.relabel.blackbox.rules
  forward_to    = [prometheus.remote_write.mimir.receiver]
  job_name      = "blackbox-ssl"
}

// 2. Probing DNS Resolution (Tambahkan IP Server DNS di sini, misal DNS Server internal / 8.8.8.8)
prometheus.scrape "blackbox_dns" {
  targets = [
    {"__address__" = "8.8.8.8:53"},
    // {"__address__" = "1.1.1.1:53"},
  ]
  metrics_path = "/probe"
  params = {
    "module" = ["dns_udp"],
  }
  relabel_rules = prometheus.relabel.blackbox.rules
  forward_to    = [prometheus.remote_write.mimir.receiver]
  job_name      = "blackbox-dns"
}

prometheus.relabel "blackbox" {
  rule {
    source_labels = ["__address__"]
    target_label  = "__param_target"
  }
  rule {
    source_labels = ["__param_target"]
    target_label  = "instance"
  }
  rule {
    target_label = "__address__"
    replacement  = "blackbox-exporter:9115"
  }
}

// ============================================================
// Logs → Loki (via OTLP converted to Loki format)
// ============================================================

otelcol.exporter.loki "default" {
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// ============================================================
// Docker Log Collection → Loki
// Automatically discovers and collects logs from all Docker containers
// ============================================================

discovery.docker "dockerlogs" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "dockerlogs" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex = "/(.*)"
    target_label = "service"
  }
}

loki.source.docker "default" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.docker.dockerlogs.targets
  labels     = {"platform" = "docker"}
  relabel_rules = discovery.relabel.dockerlogs.rules
  forward_to = [loki.write.default.receiver]
}